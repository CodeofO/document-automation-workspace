# Ignore everything by default.
*

# Repository entrypoints.
!.gitignore
!.env.example
!README.md
!DEVELOPMENT_DEFINITION.md
!DEVELOPMENT_PLAN.md
!ERROR_NOTE.md
!docker-compose.hosting.example.yml

# Runtime examples.
!backend/
backend/*
!backend/.env.production.example
!frontend/
frontend/*
!frontend/.env.production.example

# Backend source.
!backend/pyproject.toml
!backend/Dockerfile
!backend/alembic.ini
!backend/alembic/
backend/alembic/*
!backend/alembic/env.py
!backend/alembic/versions/
backend/alembic/versions/*
!backend/alembic/versions/*.py
!backend/app/
!backend/app/**/
!backend/app/**/*.py
!backend/tests/
!backend/tests/**/
!backend/tests/**/*.py

# Frontend source.
!frontend/index.html
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/vitest.config.ts
!frontend/playwright.config.ts
!frontend/eslint.config.js
!frontend/.prettierrc.json
!frontend/.prettierignore
!frontend/openapi.json
!frontend/public/
frontend/public/*
!frontend/public/config.js
!frontend/scripts/
!frontend/scripts/**
!frontend/src/
!frontend/src/**
!frontend/e2e/
!frontend/e2e/**

# Template data and final README media.
!docs/
docs/*
!docs/refactor-plan.md
!docs/project-insights.md
!docs/table-extraction-api.md
!docs/ux/
docs/ux/*
!docs/ux/*.md
!assets/
assets/*
!assets/readme/
assets/readme/*
!assets/readme/*.png
!assets/readme/*.gif

# Runnable scripts.
!scripts/
scripts/*
!scripts/run_dev.sh
!scripts/run_large_mock_smoke.py
!scripts/run_poc_ui_smoke.py

# Always ignored local outputs.
.env
*.env
.venv/
.uv-cache/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
*.pyc
*.pyo
*.log
*.tmp
*.bak
.DS_Store
.coverage
coverage/
htmlcov/
playwright-report/
test-results/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/*.tsbuildinfo
backend/*.db*
backend/*.sqlite*
backend/*.sqlite3*
backend/storage/
